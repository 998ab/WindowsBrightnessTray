#include "version.h"
100 ICON "app.ico"
101 RCDATA "../locales/en.tsv"
102 RCDATA "../locales/ru.tsv"
1 VERSIONINFO
FILEVERSION BRIGHTNESSTRAY_VERSION_NUMBERS
PRODUCTVERSION BRIGHTNESSTRAY_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "998ab\0"
            VALUE "FileDescription", "BrightnessTray display brightness control\0"
            VALUE "FileVersion", BRIGHTNESSTRAY_VERSION "\0"
            VALUE "InternalName", "BrightnessTray\0"
            VALUE "OriginalFilename", "BrightnessTray.exe\0"
            VALUE "ProductName", "BrightnessTray\0"
            VALUE "ProductVersion", BRIGHTNESSTRAY_VERSION "\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 998ab\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
